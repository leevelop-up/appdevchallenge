<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_enabled="false">
        <shape><solid android:color="@android:color/transparent" /><corners android:radius="6dp" /><stroke android:width="1dp" android:color="#2A2C2F" /></shape>
    </item>
    <item android:state_pressed="true">
        <shape><solid android:color="#2C2E31" /><corners android:radius="6dp" /><stroke android:width="1dp" android:color="@color/muted" /></shape>
    </item>
    <item>
        <shape><solid android:color="@android:color/transparent" /><corners android:radius="6dp" /><stroke android:width="1dp" android:color="#5A5D62" /></shape>
    </item>
</selector>
